<?xml version="1.0" encoding="utf-8"?>
<!--
  Body composition and training data are sensitive: exclude everything from cloud backup and
  device-to-device transfer. Users can export intentionally from Settings instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
